# ═══════════════════════════════════════════════════════════════════════════
# Splitz self-host — biến môi trường cho docker-compose.supabase.yml.
#
#   cp .env.docker.example .env.docker
#
# Sinh 4 giá trị bên dưới BẰNG 1 lệnh (copy nguyên khối, chạy ở máy có node):
#
#   node -e '
#     const c = require("crypto");
#     const pw = c.randomBytes(24).toString("base64url");
#     const jwt = c.randomBytes(32).toString("base64");
#     const enc = (o) => Buffer.from(JSON.stringify(o)).toString("base64url");
#     const key = (role) => {
#       const h = enc({ alg: "HS256", typ: "JWT" });
#       const p = enc({ role, iat: Math.floor(Date.now()/1e3), exp: 19e11 });
#       const s = c.createHmac("sha256", jwt).update(h + "." + p).digest("base64url");
#       return h + "." + p + "." + s;
#     };
#     console.log("POSTGRES_PASSWORD=" + pw);
#     console.log("JWT_SECRET=" + jwt);
#     console.log("ANON_KEY=" + key("anon"));
#     console.log("SERVICE_ROLE_KEY=" + key("service_role"));
#   '
#
# KHÔNG commit file .env.docker. KHÔNG lộ SERVICE_ROLE_KEY cho client —
# ANON_KEY mới là key công khai đưa vào app.
# ═══════════════════════════════════════════════════════════════════════════

# ── Bắt buộc ──
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ── URL công khai ──
# Trình duyệt dùng 2 URL này để mở app và gọi API (đổi theo domain VPS +
# port/khi có reverse-proxy TLS thì bỏ port):
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8081
# Các URL chuyển hướng OAuth/phục hồi thêm (phân tách bằng dấu ,) — có thể để trống.
ADDITIONAL_REDIRECT_URLS=

# ── Cổng host ──
SPLITZ_PORT=8080
API_PORT=8081
STUDIO_PORT=8082

# ── Auth ──
# false nếu muốn TẮT đăng ký mới (người dùng chỉ do admin tạo trong Studio).
DISABLE_SIGNUP=false
# false nếu có SMTP thật và muốn mail xác thực (khi đó điền khối SMTP bên dưới).
ENABLE_EMAIL_AUTOCONFIRM=true
# Bật đăng nhập email + mật khẩu trong app (GoTrue email provider). Nút
# Google/Zalo vẫn hiển thị; bản self-host không cấu hình OAuth thì đây là
# phương thức đăng nhập chính.
ENABLE_EMAIL_SIGNUP=true

# ── SMTP (tuỳ chọn — để trống là dùng autoconfirm) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

# ── Storage ──
STORAGE_BUCKET=splitz-attachments
STORAGE_REGION=local
# Sinh: openssl rand -hex 32
IMGPROXY_REQUEST_SIGNING_KEY=
