# ─────────────────────────────────────────────────────────────────────────────
# Splitz — biến môi trường. Copy file này thành `.env.local` rồi điền dần.
#
# Không điền gì cũng chạy được: app tự về chế độ LOCAL (localStorage), không cần
# tài khoản, không cần backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── URL công khai của bản deploy ──
# Dùng để sinh thẻ OG/Twitter tuyệt đối trong index.html và link trong email.
# Bỏ trống = http://localhost:5173. Khi deploy PHẢI đặt biến này.
VITE_SITE_URL=

# ── Supabase (bật chế độ CLOUD) ──
# Điền 2 biến này = đăng nhập BẮT BUỘC + đồng bộ dữ liệu lên Supabase.
VITE_SUPABASE_URL=
# Publishable key dạng sb_publishable_... (Supabase → Settings → API Keys).
VITE_SUPABASE_ANON_KEY=

# ── Đăng nhập Google (chế độ cloud) ──
# 1) Supabase Dashboard -> Authentication -> Providers -> Google: bật + điền Client ID/Secret.
# 2) Google Cloud Console -> OAuth consent + Credentials (Web): thêm Authorized redirect URI
#    là https://<project-ref>.supabase.co/auth/v1/callback
# 3) Supabase -> Authentication -> URL Configuration: thêm Site URL + Redirect URLs
#    (vd https://your-domain và http://localhost:5173) để OAuth quay về đúng app.

# ── Đăng nhập Zalo (chế độ cloud) ──
# Frontend chỉ cần App ID (public). Có biến này thì nút Zalo ở màn đăng nhập sẽ bật.
VITE_ZALO_APP_ID=
# Token xác thực tên miền của Zalo (developers.zalo.me). Có biến này thì lúc build
# mới sinh thẻ <meta name="zalo-platform-site-verification"> trong index.html.
VITE_ZALO_VERIFICATION=
#
# Backend (Edge Function zalo-auth) — đặt qua Supabase secrets, KHÔNG để lộ ở frontend:
#   supabase secrets set ZALO_APP_ID=<app_id>
#   supabase secrets set ZALO_APP_SECRET=<secret_key>
#   supabase secrets set ZALO_TOKEN_SECRET=<chuỗi ngẫu nhiên dài, tự sinh>
#   supabase secrets set APP_ORIGINS=https://your-domain,http://localhost:5173
# Deploy: supabase functions deploy zalo-auth
#
# Cấu hình app Zalo (developers.zalo.me):
# 1) Thêm Redirect URI: https://your-domain/auth/zalo/callback (và localhost khi dev).
# 2) Zalo KHÔNG trả email → app dùng email do user xác thực OTP lần đầu (đã xử lý sẵn).
# 3) Đảm bảo Supabase Auth đã bật Email provider (để gửi/verify OTP định danh).

# ── Premium / PayOS ──
# Frontend: public key VAPID để đăng ký web push (bật toggle thông báo).
VITE_VAPID_PUBLIC_KEY=
#
# Edge Function secrets (supabase secrets set ...), KHÔNG để ở frontend:
#   PayOS:  PAYOS_CLIENT_ID, PAYOS_API_KEY, PAYOS_CHECKSUM_KEY, APP_URL=https://your-domain
#   Email:  RESEND_API_KEY, RESEND_FROM="Splitz <noreply@domain-da-verify-o-Resend>"
#   Push:   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (sinh: npx web-push generate-vapid-keys),
#           VAPID_SUBJECT=mailto:admin@your-domain
# Deploy: supabase functions deploy payos-create payos-webhook send-reminders
#
# Cấu hình PayOS (my.payos.vn): thêm Webhook URL =
#   https://<PROJECT_REF>.functions.supabase.co/payos-webhook
# Lịch nhắc gia hạn: bật pg_cron + pg_net, chạy SQL cron trong 0014_reminders.sql.
# Mã kích hoạt: tạo trong bảng redemption_codes (SQL/Dashboard), user nhập ở Nâng cấp.

# ── Analytics & crash — tuỳ chọn, trống = tắt ──
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
